# Backend (FastAPI) origin. Used by the Next.js server for SSR fetches and for the /api + /static rewrites.
API_ORIGIN=http://127.0.0.1:8000
# Public URL of this site (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Search Console HTML-tag verification code (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
