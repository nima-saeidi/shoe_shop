# ===== Domains =====================================================================
# Production: bare domain names -> Caddy issues HTTPS certificates automatically
# (point the DNS A records of all three at this server first; ports 80 and 443 must be open).
SITE_DOMAIN=panik.example.com
ADMIN_DOMAIN=admin.panik.example.com
API_DOMAIN=api.panik.example.com
# Public URL of the shop, used for canonical links / sitemap / Open Graph (rebuild storefront after changing).
SITE_PUBLIC_URL=https://panik.example.com

# Google Search Console: the code from the "HTML tag" verification method (content="..."). Optional.
GOOGLE_SITE_VERIFICATION=

# Local testing instead (plain HTTP, no certificates):
#   SITE_DOMAIN=http://localhost
#   ADMIN_DOMAIN=http://admin.localhost
#   API_DOMAIN=http://api.localhost
#   SITE_PUBLIC_URL=http://localhost
#   ENVIRONMENT=development      # production sets secure-only session cookies, which need HTTPS

# ===== Database ====================================================================
POSTGRES_USER=shoe_user
# Use letters/digits only (it is embedded in a connection URL).
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shoe_shop

# ===== Backend ======================================================================
ENVIRONMENT=production
PROJECT_NAME=Shoe Shop
# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"  (use two different values)
SECRET_KEY=
SESSION_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_NUMBER=
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=https://api.panik.example.com/api/v1/payments/callback
WHOLESALE_MIN_ORDER_AMOUNT=0

# Host ports (change only if 80/443 are taken)
HTTP_PORT=80
HTTPS_PORT=443

# Python package index used while building the backend image. Switch to a mirror if pypi.org is slow/blocked, e.g.
# PIP_INDEX_URL=https://mirror-pypi.runflare.com/simple
PIP_INDEX_URL=https://pypi.org/simple
