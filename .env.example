PROJECT_NAME=Shoe Shop
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/shoe_shop
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:admin@localhost:5432/shoe_shop

# Generate real values before running: python -c "import secrets; print(secrets.token_hex(32))"
# Never commit real secrets or reuse the same value for both keys.
SECRET_KEY=change-this-secret-key-in-production
SESSION_SECRET_KEY=change-this-session-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

UPLOAD_DIR=app/static/uploads
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# SMS gateway (leave empty until a provider is chosen — falls back to logging)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_NUMBER=

# Payment gateway (leave empty until a provider is chosen)
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=http://localhost:8000/api/v1/payments/callback

WHOLESALE_MIN_ORDER_AMOUNT=0
